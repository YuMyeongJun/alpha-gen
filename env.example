# alpha-gen paper onboarding template
# Copy to .env and fill in real values (never commit .env)
#
#   Windows:  copy env.example .env
#   bash:     cp env.example .env
#
# Paper target: MOCK_MODE=false, IS_REAL_TRADING=false, ALLOW_LIVE_TRADING=false
# Paper broker sync: worker cycle only (default 300s min interval)
# PAPER_BROKER_SYNC_INTERVAL_SEC=300

# ─── Trading mode ───
MOCK_MODE=false
IS_REAL_TRADING=false
ALLOW_LIVE_TRADING=false
AUTO_MOCK_ON_MISSING_KIS=true

# ─── Operating stage (mock|paper|shadow|live_limited|live_full) ───
ALPHA_GEN_STAGE=paper
EMERGENCY_STOP=false

# ─── KIS Open API (모의투자 — IS_REAL_TRADING=false) ───
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
ACCOUNT_NO=12345678
ACCOUNT_CODE=01

# ─── Anthropic (news sentiment) ───
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Optional: Telegram alerts ───
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Optional: runtime ───
# ALPHA_GEN_HOST=127.0.0.1
# ALPHA_GEN_PORT=8000
# ALPHA_GEN_DB_PATH=data/alpha_gen.sqlite3
