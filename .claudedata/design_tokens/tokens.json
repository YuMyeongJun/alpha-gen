{
  "$meta": {
    "name": "alpha-gen design system core",
    "extracted_from": "frontend/src/styles.scss (:root) + frontend/src/styles/console.css",
    "extracted_at": "2026-08-12",
    "source_of_truth": "frontend/src/styles.scss 가 런타임 진실. 이 파일은 감사·핸드오프용 정규화 사본이며, 토큰을 바꿀 땐 styles.scss를 먼저 고치고 여기 반영한다.",
    "note": "Figma MCP는 현재 미연동. 아래 light 값은 실제 코드에서 추출한 것이고, dark 값은 Phase 0 제안(초안)으로 온-스크린 검증 필요."
  },
  "typography": {
    "font": "\"Pretendard\", \"Pretendard Variable\", -apple-system, BlinkMacSystemFont, \"Apple SD Gothic Neo\", \"Noto Sans KR\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "font-mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "base-size": "14px",
    "line-height": 1.5,
    "features": "tnum 1, cv11 1"
  },
  "layout": {
    "--sidebar-w": "248px",
    "--topbar-h": "52px",
    "hairline": "1px, DPR>=2에서 0.5px"
  },
  "radii": { "--r-sm": "6px", "--r-md": "8px", "--r-lg": "12px", "--r-xl": "16px" },
  "tokens": {
    "surface": {
      "--bg":          { "light": "#ffffff", "dark_proposed": "#16181d" },
      "--bg-tertiary": { "light": "#f7f6f2", "dark_proposed": "#1c1e24" },
      "--bg-subtle":   { "light": "#faf9f5", "dark_proposed": "#1a1c21" },
      "--bg-hover":    { "light": "#f1efe9", "dark_proposed": "#24262d" },
      "--bg-input":    { "light": "#ffffff", "dark_proposed": "#1c1e24" }
    },
    "border": {
      "--border":        { "light": "rgba(15,17,22,0.08)", "dark_proposed": "rgba(255,255,255,0.09)" },
      "--border-strong": { "light": "rgba(15,17,22,0.14)", "dark_proposed": "rgba(255,255,255,0.16)" },
      "--border-focus":  { "light": "#2d2d2d", "dark_proposed": "#d0d0d0" }
    },
    "ink": {
      "--ink-1": { "light": "#0f1116", "dark_proposed": "#f2f3f5" },
      "--ink-2": { "light": "#3a3d44", "dark_proposed": "#c4c7cd" },
      "--ink-3": { "light": "#6b6f78", "dark_proposed": "#9297a0" },
      "--ink-4": { "light": "#9b9ea6", "dark_proposed": "#6b6f78" }
    },
    "semantic": {
      "green":  { "500": "#639922", "600": "#527d1c", "50": "#eef5e0", "100": "#dfecca", "dark_note": "다크에서 텍스트용은 500→#8fc74a 수준으로 밝히고, 50/100 틴트는 낮은 알파 오버레이로 치환 권장" },
      "red":    { "500": "#e24b4a", "600": "#c93b3a", "50": "#fdecec", "100": "#fad7d7", "dark_note": "500→#f26a69, 틴트는 알파 오버레이" },
      "blue":   { "500": "#378add", "600": "#2871b8", "50": "#e6f0fb", "100": "#cfe2f7", "dark_note": "500→#5aa3e8" },
      "amber":  { "500": "#d08a1a", "50": "#fbf1de", "dark_note": "500→#e0a63a" },
      "gray":   { "500": "#6b6f78", "50": "#eef0f3", "100": "#e3e5ea" }
    },
    "accent": {
      "--accent":     { "light": "#c96f3d", "dark_proposed": "#d98a5e" },
      "--accent-600": { "light": "#b75f30", "dark_proposed": "#c96f3d" },
      "--accent-50":  { "light": "#faece2", "dark_proposed": "rgba(201,111,61,0.16)" }
    },
    "shadow": {
      "--shadow-1":   { "light": "0 1px 2px rgba(15,17,22,0.04)",  "dark_proposed": "0 1px 2px rgba(0,0,0,0.4)" },
      "--shadow-2":   { "light": "0 4px 16px rgba(15,17,22,0.06)", "dark_proposed": "0 4px 16px rgba(0,0,0,0.5)" },
      "--shadow-pop": { "light": "0 12px 32px rgba(15,17,22,0.12)","dark_proposed": "0 12px 32px rgba(0,0,0,0.6)" }
    }
  },
  "trading_semantics": {
    "positive / num-pos": "var(--green-600), weight 500 (수익)",
    "negative / num-neg": "var(--red-600), weight 500 (손실)",
    "neutral": "var(--ink-3)",
    "warning(shadow mode)": "amber 계열 권장",
    "danger(live_*, emergency_stop)": "red 계열 + 강조 badge (frontend-ops-console 룰)"
  }
}
